---
// 14 x 12 pixel cat lying on the nav panel, traced from the nav layout.
// "o" is an eye, "t" is the tip of the tail that swishes.
const rows = [
  '.........#...#',
  '...#####.#####',
  '..############',
  '.#########o#o#',
  '#############.',
  '##############',
  '########.##.##',
  '##............',
  '##............',
  '##............',
  '..tt..........',
  '...tt.........',
];
const pixels = rows.flatMap((row, y) =>
  [...row].map((c, x) => ({ x, y, c })).filter((p) => p.c !== '.'),
);
const { class: className = '' } = Astro.props;
---
<svg class={`sitting-cat ${className}`} viewBox="0 0 14 12" shape-rendering="crispEdges" aria-hidden="true">
  {pixels.map((p) => (
    <rect x={p.x} y={p.y} width="1" height="1" class={p.c === 'o' ? 'eye' : p.c === 't' ? 'tip' : ''} />
  ))}
</svg>

<style>
  .sitting-cat { overflow: visible; }
  rect { fill: var(--color-ink); }
  rect.eye { fill: var(--color-paper); animation: blink 5s steps(1) 1s infinite; }
  rect.tip { animation: swish 2.4s steps(1) infinite; }
  @keyframes blink { 0%, 95% { fill: var(--color-paper); } 96%, 100% { fill: var(--color-ink); } }
  @keyframes swish { 0%, 60% { transform: none; } 70%, 90% { transform: translateX(-1px); } }
  @media (prefers-reduced-motion: reduce) { rect.eye, rect.tip { animation: none; } }
</style>
