---
// The spiral stem and bloom, drawn in dots. Dots shy away from the pointer and spring back.
const { class: className, ...rest } = Astro.props;
---
<div class:list={['bloom', className]} {...rest}>
  <canvas aria-label="Spiral stem and bloom drawn in dots" role="img"></canvas>
</div>

<style>
  .bloom { --dot: #0079df; }
  canvas { display: block; width: 100%; height: auto; aspect-ratio: 720 / 441; touch-action: pan-y; }
</style>

<script>
  // Dot grid from spiral-bloom-sideways.png: 80 x 49 cells of 9px on a 720 x 441 canvas.
  const D = { cols: 80, cell: 9, r: 1.6, w: 720, h: 441, dots: [192,272,273,353,434,501,502,503,514,523,524,583,584,585,594,603,604,664,665,666,674,683,684,745,746,747,755,763,815,826,827,835,843,894,895,907,908,915,922,974,975,987,988,991,995,1002,1049,1054,1061,1062,1063,1068,1069,1072,1075,1081,1123,1128,1129,1134,1143,1144,1145,1148,1149,1152,1153,1155,1161,1168,1169,1170,1203,1208,1209,1214,1224,1225,1226,1228,1229,1232,1233,1235,1239,1240,1248,1249,1283,1284,1288,1294,1305,1306,1308,1309,1312,1313,1314,1318,1328,1329,1363,1368,1369,1375,1378,1379,1380,1381,1382,1385,1386,1387,1388,1389,1392,1393,1394,1397,1400,1407,1443,1449,1452,1455,1461,1462,1463,1466,1467,1468,1469,1472,1473,1476,1480,1481,1482,1487,1523,1529,1531,1532,1535,1537,1542,1543,1544,1547,1548,1549,1552,1553,1555,1562,1563,1566,1604,1609,1610,1611,1612,1616,1623,1624,1625,1628,1629,1632,1633,1634,1636,1637,1642,1643,1644,1645,1684,1687,1688,1689,1690,1691,1692,1696,1704,1705,1708,1711,1712,1713,1716,1717,1723,1724,1765,1767,1768,1769,1770,1772,1773,1776,1777,1784,1785,1786,1788,1789,1791,1792,1793,1796,1800,1801,1803,1804,1810,1811,1828,1845,1847,1852,1856,1857,1864,1865,1866,1867,1868,1869,1870,1871,1873,1875,1879,1883,1884,1889,1890,1891,1908,1926,1927,1931,1936,1937,1938,1944,1945,1946,1947,1949,1950,1952,1953,1954,1957,1958,1962,1963,1964,1968,1969,1970,1985,1986,1987,1988,1989,1990,1991,2002,2003,2007,2008,2012,2016,2017,2019,2023,2024,2025,2026,2027,2028,2029,2032,2034,2035,2041,2042,2043,2046,2047,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2082,2083,2087,2088,2089,2093,2094,2096,2097,2098,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2120,2121,2122,2123,2124,2125,2138,2139,2140,2141,2152,2153,2154,2155,2163,2164,2168,2169,2170,2175,2177,2178,2179,2183,2184,2185,2186,2187,2188,2189,2190,2191,2194,2196,2197,2199,2200,2201,2202,2217,2218,2235,2236,2245,2246,2249,2250,2251,2252,2256,2257,2258,2259,2260,2261,2263,2264,2265,2266,2267,2268,2269,2270,2271,2276,2277,2278,2279,2280,2297,2298,2315,2316,2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2377,2378,2383,2384,2385,2386,2387,2388,2389,2396,2411,2412,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2429,2430,2431,2432,2433,2434,2457,2461,2462,2469,2470,2475,2476,2496,2497,2498,2501,2502,2503,2504,2505,2507,2513,2514,2515,2517,2518,2519,2520,2525,2526,2537,2541,2549,2550,2556,2564,2565,2575,2576,2577,2579,2580,2581,2583,2584,2585,2587,2588,2594,2595,2596,2600,2601,2602,2603,2604,2605,2606,2616,2617,2621,2630,2636,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2659,2660,2661,2662,2663,2664,2665,2667,2668,2669,2671,2675,2676,2696,2697,2701,2705,2710,2711,2716,2734,2735,2736,2738,2739,2740,2741,2742,2743,2744,2745,2748,2749,2751,2752,2755,2756,2777,2781,2785,2786,2790,2791,2796,2813,2814,2815,2818,2819,2821,2822,2824,2825,2828,2829,2831,2832,2835,2836,2837,2856,2857,2861,2865,2866,2870,2871,2876,2893,2894,2896,2898,2899,2900,2901,2905,2908,2909,2912,2913,2915,2916,2936,2937,2941,2942,2944,2945,2946,2950,2951,2956,2957,2968,2972,2973,2978,2979,2985,2988,2989,2992,2993,3013,3014,3015,3016,3017,3021,3022,3023,3024,3025,3030,3031,3036,3048,3049,3050,3051,3058,3059,3063,3065,3068,3069,3072,3073,3074,3082,3083,3097,3098,3110,3115,3116,3138,3139,3140,3144,3145,3146,3147,3148,3153,3154,3163,3177,3178,3189,3190,3195,3196,3219,3220,3221,3226,3234,3235,3242,3243,3257,3258,3266,3267,3268,3269,3270,3275,3276,3300,3301,3302,3303,3306,3315,3316,3323,3324,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3354,3355,3356,3386,3396,3397,3404,3405,3418,3419,3420,3421,3422,3423,3424,3425,3426,3433,3434,3435,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3511,3512,3513,3514,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3643,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3737] };
  const PUSH_RADIUS = 70; // css px around the pointer that dots move away from
  const PUSH = 8;         // how far a dot right under the pointer is pushed, css px
  const SPRING = 0.035, DAMP = 0.86;

  document.querySelectorAll<HTMLElement>('.bloom').forEach((root) => {
    const cv = root.querySelector('canvas')!;
    const ctx = cv.getContext('2d')!;
    const color = getComputedStyle(root).getPropertyValue('--dot').trim();
    const dots = D.dots.map((i) => {
      const c = i % D.cols, r = (i - c) / D.cols;
      const x = (c + 0.5) * D.cell, y = (r + 0.5) * D.cell;
      return { hx: x, hy: y, x, y, vx: 0, vy: 0 };
    });
    let scale = 1, dpr = 1, mouse: { x: number; y: number } | null = null, running = false;

    const frame = () => {
      const R = PUSH_RADIUS / scale, P = PUSH / scale;
      let moving = false;
      for (const d of dots) {
        let tx = d.hx, ty = d.hy;
        if (mouse) {
          const dx = d.hx - mouse.x, dy = d.hy - mouse.y, dist = Math.hypot(dx, dy);
          if (dist < R) {
            const t = 1 - dist / R, f = t * t * (3 - 2 * t) * P, n = dist || 1;
            tx += (dx / n) * f; ty += (dy / n) * f;
          }
        }
        d.vx = (d.vx + (tx - d.x) * SPRING) * DAMP;
        d.vy = (d.vy + (ty - d.y) * SPRING) * DAMP;
        d.x += d.vx; d.y += d.vy;
        if (Math.abs(d.vx) + Math.abs(d.vy) + Math.abs(tx - d.x) + Math.abs(ty - d.y) > 0.02) moving = true;
      }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
      ctx.clearRect(0, 0, D.w, D.h);
      ctx.fillStyle = color;
      ctx.beginPath();
      for (const d of dots) { ctx.moveTo(d.x + D.r, d.y); ctx.arc(d.x, d.y, D.r, 0, Math.PI * 2); }
      ctx.fill();
      // Stop drawing once everything has settled; the next pointer move wakes it.
      running = moving || !!mouse;
      if (running) requestAnimationFrame(frame);
    };
    const wake = () => { if (!running) { running = true; requestAnimationFrame(frame); } };

    const resize = () => {
      const w = cv.clientWidth;
      dpr = devicePixelRatio || 1;
      scale = w / D.w; // canvas px -> css px
      cv.width = Math.round(w * dpr); cv.height = Math.round(D.h * scale * dpr);
      wake();
    };
    const pointer = (e: PointerEvent) => {
      const b = cv.getBoundingClientRect();
      mouse = { x: (e.clientX - b.left) / scale, y: (e.clientY - b.top) / scale };
      wake();
    };
    cv.addEventListener('pointermove', pointer);
    cv.addEventListener('pointerdown', pointer);
    cv.addEventListener('pointerleave', () => { mouse = null; wake(); });
    new ResizeObserver(resize).observe(cv);
  });
</script>
