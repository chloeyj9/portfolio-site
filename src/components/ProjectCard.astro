---
interface Props {
  title: string;
  tags: readonly string[];
  year: string;
  cover: string | null;
  accent: string;
  // Projects without a page yet show as a card that doesn't link anywhere.
  href?: string;
}
const { title, tags, year, cover, accent, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={['card', { linked: href }]} style={`--accent:${accent}`} data-reveal>
  <div class="cell media">
    {cover && <img src={cover} alt="" loading="lazy" />}
  </div>
  <div class="cell caption">
    <h3>{title}</h3>
    <p class="kind"><span>{tags.join(' & ')}</span> - {year}</p>
  </div>
</Tag>

<style>
  /* Measured on the 1920px homepage: 780 x 480 image over a 90px caption. */
  .card { display: flex; flex-direction: column; }
  .media { aspect-ratio: 780 / 480; overflow: hidden; background: var(--color-placeholder); border-color: var(--color-placeholder); }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(.2, .7, .2, 1); }
  .linked:hover .media img { transform: scale(1.04); }

  .caption {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 4px max(12px, calc(24 * var(--u)));
    min-height: max(56px, calc(90 * var(--u)));
    padding: 10px max(14px, calc(30 * var(--u)));
    font-size: max(11px, calc(16 * var(--u))); font-weight: 600; text-transform: uppercase;
    color: var(--color-muted);
  }
  h3 { transition: color 0.25s; }
  .linked:hover h3, .linked:focus-visible h3 { color: var(--color-ink); }
  .kind span { color: var(--accent); }
  .card:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; border-radius: var(--radius); }
</style>
