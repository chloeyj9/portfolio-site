---
interface Props {
  title: string;
  description: string;
  tags: readonly string[];
  year: string;
  cover: string | null;
  href: string;
}
const { title, description, tags, year, cover, href } = Astro.props;
---
<a href={href} class="card group block" data-reveal>
  <div class="media relative overflow-hidden bg-placeholder">
    {cover && (
      <img
        src={cover}
        alt=""
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.04]"
      />
    )}
    <span class="absolute inset-0 bg-ink/0 transition-colors duration-500 group-hover:bg-ink/5"></span>
  </div>
  <div class="meta flex flex-wrap items-center">
    <h3 class="mr-auto font-serif">
      <span class="title-underline">{title}</span>
    </h3>
    <div class="tags flex flex-wrap">
    {tags.map((tag) => (
      <span class="tag bg-tag font-mono uppercase text-ink/60 transition-colors duration-300 group-hover:bg-ink/15 group-hover:text-ink/80">
        {tag}
      </span>
    ))}
    <span class="tag bg-ink font-mono text-paper">{year}</span>
    </div>
  </div>
  <p class="desc text-ink/90">{description}</p>
</a>

<style>
  /* Measured on the 1560px frame: 690 x 419 image, 50px title, 20px description. */
  .media { aspect-ratio: 690 / 419; max-width: 100%; }
  .meta { margin-top: max(10px, calc(24 * var(--u))); gap: max(8px, calc(14 * var(--u))) max(12px, calc(24 * var(--u))); }
  .tags { gap: max(6px, calc(14 * var(--u))); }
  h3 { font-size: max(28px, calc(52 * var(--u))); line-height: 1; letter-spacing: -0.01em; }
  .tag { font-size: max(10px, calc(15 * var(--u))); padding: max(3px, calc(5 * var(--u))) max(8px, calc(16 * var(--u))); letter-spacing: 0.04em; }
  .desc { margin-top: max(10px, calc(20 * var(--u))); font-size: max(14px, calc(20 * var(--u))); }

  .title-underline {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.45s cubic-bezier(.2, .7, .2, 1);
  }
  .group:hover .title-underline,
  .group:focus-visible .title-underline { background-size: 100% 1px; }
</style>
