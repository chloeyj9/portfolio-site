---
// A full-window welcome that shows the walking dot cat for four seconds,
// the first time someone opens the homepage in a browser session. A click skips it.
interface Props { line: string }
// *word* in the line is set in bold italic.
const parts = Astro.props.line.split(/\*([^*]+)\*/);
---
<script is:inline>
  try {
    if (!sessionStorage.getItem('seen-loader')) document.documentElement.classList.add('loading');
  } catch { document.documentElement.classList.add('loading'); }
</script>
<div class="loader" aria-hidden="true">
  <img src="/images/loading-cat.webp" alt="" width="733" height="391" fetchpriority="high" />
  <!-- Every letter is laid out from the start (so the line stays centred) and revealed one at a time. -->
  <p aria-label={parts.join('')}>
    {parts.map((p, i) => {
      const letters = [...p].map((c) => <span class="ch">{c}</span>);
      return i % 2 ? <em>{letters}</em> : letters;
    })}
  </p>
</div>

<style>
  .loader {
    display: none; position: fixed; inset: 0; z-index: 100;
    place-content: center; justify-items: center;
    background: var(--color-paper); transition: opacity 0.5s ease;
  }
  :global(html.loading) .loader { display: grid; }
  :global(html.loading) { overflow: hidden; }
  .loader.out { opacity: 0; }
  img { width: max(220px, calc(340 * var(--u))); height: auto; }
  p {
    margin-top: max(12px, calc(20 * var(--u)));
    font-size: max(16px, calc(25 * var(--u))); color: var(--color-muted); text-align: center;
  }
  em { font-style: italic; font-weight: 700; }
  .ch { visibility: hidden; position: relative; white-space: pre; }
  .ch.on { visibility: visible; }
  /* The cursor sits after the last letter typed. */
  .ch.caret::after {
    content: ''; visibility: visible; position: absolute; left: 100%; top: 0.15em; bottom: 0.1em;
    width: 1.5px; margin-left: 1px; background: currentColor; animation: blink 0.9s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.loader');
  if (loader && root.classList.contains('loading')) {
    try { sessionStorage.setItem('seen-loader', '1'); } catch {}
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      loader.classList.add('out');
      setTimeout(() => {
        root.classList.remove('loading');
        document.dispatchEvent(new Event('loader:done'));
      }, 500);
    };
    // The line types itself out after a short pause.
    const letters = [...loader.querySelectorAll<HTMLElement>('.ch')];
    let n = 0;
    const type = () => {
      letters[n - 1]?.classList.remove('caret');
      letters[n].classList.add('on', 'caret');
      if (++n < letters.length) setTimeout(type, 40 + Math.random() * 35);
    };
    if (letters.length) setTimeout(type, 500);

    // Fade starts at 3.5s so the page is uncovered at 4s.
    setTimeout(finish, 3500);
    loader.addEventListener('click', finish);
  }
</script>
