---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { navLinks, type Page } from '../navLinks';

interface Props { current: Page; }
const { links } = await navLinks(Astro.props.current);
const footer = await createReader(process.cwd(), keystaticConfig).singletons.footer.readOrThrow();

const contact = [
  { label: footer.emailLabel, href: footer.email ? `mailto:${footer.email}` : null },
  { label: footer.linkedinLabel, href: footer.linkedinUrl || null },
];
---
<footer class="row site-footer">
  <div class="cell gutter"></div>
  <div class="cell main">
    <div class="top">
      <div>
        <h2 class="font-serif">{footer.heading}</h2>
        <ul class="list contact">
          {contact.map((c) => (
            <li>
              {c.href ? (
                <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.label}</a>
              ) : (
                <span>{c.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <nav aria-label="Footer">
        <ul class="list">
          {links.map((l) => <li>{l.href ? <a href={l.href}>{l.label}</a> : <span>{l.label}</span>}</li>)}
        </ul>
      </nav>
    </div>
    <p class="copyright">{footer.copyright}</p>
  </div>
  <div class="cell gutter"></div>
</footer>

<style>
  /* The bottom edge sits off the page, so only the upper corners show. */
  .site-footer .cell { border-bottom: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .main {
    padding: max(40px, calc(90 * var(--u))) var(--pad) max(28px, calc(40 * var(--u)));
    color: var(--color-muted);
  }
  .top { display: grid; gap: 40px; }
  @container (min-width: 700px) { .top { grid-template-columns: 1fr auto; } }
  h2 {
    color: var(--color-ink);
    font-size: max(32px, calc(64 * var(--u)));
    line-height: 1.05; text-wrap: balance;
  }
  .list {
    font-size: max(12px, calc(16 * var(--u))); font-weight: 700;
    line-height: 1.9; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .contact { margin-top: max(16px, calc(28 * var(--u))); }
  nav .list { text-align: right; }
  @container (max-width: 699px) { nav .list { text-align: left; } }
  .copyright { margin-top: max(48px, calc(90 * var(--u))); font-size: max(12px, calc(14 * var(--u))); }

  /* Links darken and draw an underline on hover. */
  a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.25s, background-size 0.4s cubic-bezier(.2, .7, .2, 1);
  }
  a:hover, a:focus-visible { color: var(--color-ink); background-size: 100% 1px; }
  a:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }
</style>
