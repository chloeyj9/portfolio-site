---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import FooterCat from './FooterCat.astro';
import { navLinks, type Page } from '../navLinks';

interface Props { current: Page; }
const { links } = await navLinks(Astro.props.current);
const footer = await createReader(process.cwd(), keystaticConfig).singletons.footer.readOrThrow();

// Site links, then contact links. Anything without an address shows as plain text.
const items = [
  ...links,
  { key: 'email', label: footer.emailLabel, href: footer.email ? `mailto:${footer.email}` : undefined },
  { key: 'linkedin', label: footer.linkedinLabel, href: footer.linkedinUrl || undefined },
];
---
<footer class="site-footer">
  <div class="inner">
    <div class="hello">
      <FooterCat class="cat" />
      <h2 class="text-display">{footer.heading}</h2>
    </div>
    <p class="copyright">{footer.copyright}</p>
    <nav aria-label="Footer">
      <ul class="text-display">
        {items.map((l) => (
          <li>
            {l.href ? (
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>
            ) : (
              <span>{l.label}</span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  /* Measured on the 1920 x 484 footer mockup. The pink runs edge to edge. */
  .site-footer { background: #ffecf7; color: #b8237a; container-type: inline-size; }
  .inner {
    max-width: 1920px; margin-inline: auto;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 32px;
    padding: max(48px, calc(95 * var(--u))) var(--gutter) max(48px, calc(98 * var(--u)));
  }
  /* 18 pixel columns (one spare on the left for the tail), each 150/17 wide, pulled left so the cat lines up. */
  .hello :global(.cat) {
    --w: max(80px, calc(150 * var(--u)));
    display: block; width: calc(var(--w) * 18 / 17); height: auto; aspect-ratio: 2700 / 2431;
    margin-left: calc(var(--w) / -17);
  }
  h2 { margin-top: max(8px, calc(12 * var(--u))); white-space: pre-line; }
  .copyright { font-size: max(12px, calc(16 * var(--u))); padding-bottom: 0.3em; text-align: center; }
  nav { justify-self: end; text-align: right; }

  /* Links draw an underline on hover. */
  a {
    background: linear-gradient(currentColor, currentColor) 0 92% / 0 2px no-repeat;
    transition: background-size 0.4s cubic-bezier(.2, .7, .2, 1);
  }
  a:hover, a:focus-visible { background-size: 100% 2px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* Narrow screens: cat and heading, then the links, then the copyright. */
  @container (max-width: 760px) {
    .inner { grid-template-columns: 1fr; align-items: start; }
    nav { justify-self: start; text-align: left; grid-row: 2; }
    .copyright { grid-row: 3; text-align: left; }
  }
</style>
