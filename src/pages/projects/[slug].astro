---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Layout from '../../layouts/Layout.astro';
import { richText, inline, lines } from '../../richText';
import { squarify, shade } from '../../treemap';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  // Same order as the home page; each page links on to the project after it.
  const projects = (await reader.collections.projects.all())
    .filter((p) => !p.entry.hidden)
    .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0));
  return projects
    .map((p, i) => ({ p, next: projects[i + 1] ?? projects[0] }))
    .filter(({ p }) => p.entry.caseStudy.enabled)
    .map(({ p, next }) => ({
      params: { slug: p.slug },
      props: {
        project: p.entry,
        next: {
          title: next.entry.title,
          cover: next.entry.cover,
          // A project without its own page yet shows as "Coming soon!".
          href: next.entry.caseStudy.enabled ? `/projects/${next.slug}` : null,
        },
      },
    }));
}

const { project, next } = Astro.props;
const cs = project.caseStudy;
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Sections with a nav name become the links in the section bar.
const sections = cs.sections.map((s) => {
  const v = s.value as { navLabel?: string; label?: string };
  return { ...s, anchor: v.navLabel ? id(v.navLabel) : undefined };
});
const navSections = sections
  .filter((s) => s.anchor)
  .map((s) => ({ key: s.anchor!, label: (s.value as { navLabel: string }).navLabel, href: `#${s.anchor}` }));

const meta = [
  { label: 'Role', items: lines(cs.role) },
  { label: 'Team', items: lines(cs.team) },
  { label: 'Timeline', items: lines(cs.timeline) },
  { label: 'Skills', items: lines(cs.skills) },
].filter((m) => m.items.length);
---
<Layout title={`${project.title} · Chloe Jung`} current="project" sections={navSections}>
  <div class="cs" style={`--accent:${cs.accent || "#175c35"};--tint:${cs.tint || "#d5eade"}`}>
    <div class="row">
      <div class="cell"></div>
      <div class="intro-pair">
        <div class="cell intro-left">
          <p class="kind"><span>{project.tags.join(' & ')}</span> - {project.year}</p>
          <h1 class="title">{cs.headline || project.title}</h1>
        </div>
        <div class="cell intro-right">
          <div class="summary prose" set:html={richText(cs.summary)} />
          <dl class="meta">
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.items.map((i) => <span>{i}</span>)}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
      <div class="cell"></div>
    </div>

    <div class="row">
      <div class="cell"></div>
      <div class="cell hero media">{cs.hero && <img src={cs.hero} alt="" />}</div>
      <div class="cell"></div>
    </div>

    <div class="row">
    <div class="cell"></div>
    <article class="cell case">
    {sections.map((s) => {
      const heading = (v: { label?: string; heading?: string }) => (
        <>
          {v.label && <p class="eyebrow">{v.label}</p>}
          {v.heading && <h2 class="section-title">{v.heading}</h2>}
        </>
      );

      if (s.discriminant === 'textWithImages') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class:list={['split split-images', { big: v.bigImages }]}>
              <div class="prose" set:html={richText(v.body)} />
              <div class="image-row">
                {v.images.map((src, i) =>
                  src ? <img src={src} alt="" /> : <div class={`media placeholder ${i === 0 && v.images.length > 1 ? 'narrow' : 'wide'}`} />,
                )}
              </div>
            </div>
          </section>
        );
      }

      if (s.discriminant === 'cards') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            {v.intro && <div class:list={['prose intro', v.narrowIntro ? 'card-intro-narrow' : 'wide-intro']} set:html={richText(v.intro)} />}
            <div class:list={['cards', { tinted: v.tinted, two: v.cards.length === 2 }]}>
              {v.cards.map((c) => (
                <div class="card">
                  {!v.tinted && <div class="media card-media">{c.image && <img src={c.image} alt="" />}</div>}
                  <h3>{c.title}</h3>
                  <div class="prose" set:html={richText(c.text)} />
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (s.discriminant === 'callout') {
        const v = s.value;
        return (
          <aside class="callout" data-reveal>
            <p class="eyebrow">{v.label}</p>
            <p class:list={['callout-text', { serif: v.serif }]} set:html={inline(v.text)} />
          </aside>
        );
      }

      if (s.discriminant === 'text') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class:list={['prose', 'intro', { 'wide-intro': v.wide, 'narrow-intro': v.narrow && !v.wide }]} set:html={richText(v.body)} />
          </section>
        );
      }

      if (s.discriminant === 'images') {
        const v = s.value;
        return (
          v.images.every((im) => im.image) && !v.crop ? (
            <div class="image-strip natural" data-reveal>
              {v.images.map((im) => <img src={im.image!} alt="" style={`flex:${im.width || 1}`} />)}
            </div>
          ) : (
            <div class="image-strip" data-reveal>
              {v.images.map((im) => (
                <div class="media" style={`flex:${im.width || 1}`}>{im.image && <img src={im.image} alt="" />}</div>
              ))}
            </div>
          )
        );
      }

      if (s.discriminant === 'stats') {
        const v = s.value;
        const image = <div class:list={['media stats-media', { filled: v.image }]}>{v.image && <img src={v.image} alt="" />}</div>;
        const list = (
          <ul class="stats">
            {v.stats.map((st) => (
              <li>
                <span class="pill">{st.value}</span>
                <div>
                  <p class="stat-line">{st.line}</p>
                  <p class="stat-detail">{st.detail}</p>
                  {st.quote && <blockquote class="stat-quote">{st.quote}</blockquote>}
                </div>
              </li>
            ))}
          </ul>
        );
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            {v.imageRight ? (
              <div class:list={['split stats-split image-right', { 'has-image': v.image }]}>
                <div>
                  {v.intro && <div class="prose stats-intro" set:html={richText(v.intro)} />}
                  {list}
                  {v.quote && <blockquote>{v.quote}</blockquote>}
                </div>
                {image}
              </div>
            ) : (
              <div class="split stats-split">
                <div>
                  <div class="prose" set:html={richText(v.intro)} />
                  {image}
                </div>
                <div>
                  {list}
                  {v.quote && <blockquote>{v.quote}</blockquote>}
                </div>
              </div>
            )}
          </section>
        );
      }

      if (s.discriminant === 'features') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            {v.intro && <div class="prose intro" set:html={richText(v.intro)} />}
            <div class="split features">
              <ul class="feature-list">
                {v.items.map((it) => (
                  <li>
                    <h3>{it.title}</h3>
                    <div class="prose" set:html={richText(it.text)} />
                  </li>
                ))}
              </ul>
              {v.video ? (
                <div class="feature-media has-video"><video src={v.video} muted loop playsinline autoplay preload="metadata" /></div>
              ) : (
                <div class="media feature-media">{v.image && <img src={v.image} alt="" />}</div>
              )}
            </div>
          </section>
        );
      }

      if (s.discriminant === 'mediaText') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            {v.intro && <div class="prose intro mt-intro" set:html={richText(v.intro)} />}
            <div class:list={['split media-text', { 'image-left': v.imageLeft, 'big-image': v.bigImage }]}>
              <div class="media mt-media">{v.image && <img src={v.image} alt="" />}</div>
              <div class="prose mt-body" set:html={richText(v.body)} />
            </div>
          </section>
        );
      }

      if (s.discriminant === 'accordion') {
        const v = s.value;
        return (
          <section id={s.anchor} class:list={['section accordion-section', { dark: v.dark }]} data-reveal>
            {heading(v)}
            {v.intro && <div class="prose intro" set:html={richText(v.intro)} />}
            <div class="split accordion">
              <div class="acc-list">
                {v.items.map((it, i) => (
                  <div class:list={['acc-item', { open: i === 0 }]} data-slide={it.video || it.image ? i : 'default'}>
                    <button type="button" class="acc-head" aria-expanded={i === 0 ? 'true' : 'false'}>
                      <span><strong>{it.title}:</strong> {it.subtitle}</span>
                      <span class="acc-icon" aria-hidden="true"></span>
                    </button>
                    <div class="acc-panel"><div class="acc-inner prose" set:html={richText(it.body)} /></div>
                  </div>
                ))}
              </div>
              <div class="media acc-media">
                {v.items.map((it, i) => (it.video || it.image) && (
                  <div class:list={['acc-slide', { on: i === 0 }]} data-slide={i} style={`--framing: ${it.framing ?? 50}%`}>
                    {it.video
                      ? <video src={it.video} muted loop playsinline preload="auto" autoplay={i === 0} />
                      : <img src={it.image!} alt="" />}
                    {it.floats.map((f, j) => f.image && (
                      <img
                        class="acc-float"
                        src={f.image}
                        alt=""
                        style={`left:${f.left}%;top:${f.top}%;width:${f.width}%;animation-delay:${-j * 2.3}s`}
                      />
                    ))}
                  </div>
                ))}
                {v.image && (
                  <div class:list={['acc-slide', { on: !(v.items[0]?.video || v.items[0]?.image) }]} data-slide="default">
                    <img src={v.image} alt="" />
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      }

      if (s.discriminant === 'nextSteps') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class="split next">
              <div>
                <div class="prose" set:html={richText(v.intro)} />
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>{v.tableHeadA}</th><th>{v.tableHeadB}</th></tr></thead>
                    <tbody>{v.rows.map((r) => <tr><td>{r.a}</td><td>{r.b}</td></tr>)}</tbody>
                  </table>
                </div>
              </div>
              <div class="prose">
                {v.sideTitle && <p><strong>{v.sideTitle}</strong></p>}
                <div class="side-body" set:html={richText(v.sideBody)} />
              </div>
            </div>
          </section>
        );
      }

      if (s.discriminant === 'textAndImage') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class="split text-image">
              <div class="prose" set:html={richText(v.body)} />
              {v.image ? <img class="sketch" src={v.image} alt="" /> : <div class="media placeholder wide" />}
            </div>
          </section>
        );
      }

      if (s.discriminant === 'impact') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section impact-section" data-reveal>
            {v.label && <p class="eyebrow">{v.label}</p>}
            <ul class="impact">
              {v.items.map((it) => <li><span class="impact-value" data-count={it.value}>{it.value}</span><span class="impact-label">{it.label}</span></li>)}
            </ul>
          </section>
        );
      }

      if (s.discriminant === 'circles') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class="split circles-split">
              <ul class="circles">
                {v.circles.map((c) => (
                  <li>
                    <span class="media circle">{c.image && <img src={c.image} alt="" />}</span>
                    <span class="circle-label">{c.label}</span>
                  </li>
                ))}
              </ul>
              <div>
                <div class="prose" set:html={richText(v.body)} />
                {v.legend.length > 0 && (
                  <ul class="legend">
                    {v.legend.map((l) => (
                      <li><span class:list={['swatch', { hollow: l.outline }]} style={`--swatch:${l.color}`}></span>{l.label}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </section>
        );
      }

      if (s.discriminant === 'survey') {
        const v = s.value;
        const key = s.anchor || 'survey';
        return (
          <section id={s.anchor} class="section" data-reveal>
            <div class="split survey-split">
              <div>
                {heading(v)}
                <div class="prose survey-body" set:html={richText(v.body)} />
                <div class="tabs" data-tabs>
                  <div class="tab-list" role="tablist">
                    {v.tabs.map((t, i) => (
                      <button type="button" role="tab" class="tab" id={`${key}-tab-${i}`} aria-controls={`${key}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--c:${t.color}`}>{t.name}</button>
                    ))}
                  </div>
                  <div class="tab-panels">
                  {v.tabs.map((t, i) => (
                    <div class:list={['tab-panel', { off: i !== 0 }]} role="tabpanel" id={`${key}-panel-${i}`} aria-labelledby={`${key}-tab-${i}`} aria-hidden={i !== 0 ? 'true' : undefined} inert={i !== 0} style={`--c:${t.color}`}>
                      {t.quote && <p class="tab-quote">{t.quote}</p>}
                      {t.stats.length > 0 && (
                        <ul class="tab-stats">
                          {t.stats.map((st) => <li><span class="tab-pill">{st.value}</span><span>{st.text}</span></li>)}
                        </ul>
                      )}
                      {(t.highlightLabel || t.highlight) && <p class="tab-highlight"><strong>{t.highlightLabel}</strong> {t.highlight}</p>}
                      {t.note && <p class="tab-note">{t.note}</p>}
                    </div>
                  ))}
                  </div>
                </div>
              </div>
              <div class="survey-visuals">
                {v.tabs.map((t, i) => {
                  const c = t.chart;
                  const cls = ['visual', { off: i !== 0 }];
                  const hide = i !== 0 ? 'true' : undefined;
                  if (!c.bars.length) {
                    return <div class:list={[...cls, 'media survey-media']} aria-hidden={hide}>{v.image && <img src={v.image} alt="" />}</div>;
                  }
                  if (c.type === 'pie') {
                    // Slices go clockwise from 12 o'clock; each label sits partway out along its slice's middle.
                    const total = c.bars.reduce((sum, b) => sum + (b.value ?? 0), 0) || 1;
                    const pt = (a: number, r: number) => [50 + r * Math.sin(a), 50 - r * Math.cos(a)].map((n) => n.toFixed(3)).join(' ');
                    let at = 0;
                    const slices = c.bars.map((b, k) => {
                      const a0 = (at / total) * 2 * Math.PI;
                      at += b.value ?? 0;
                      const a1 = (at / total) * 2 * Math.PI;
                      const mid = (a0 + a1) / 2;
                      const big = a1 - a0 > Math.PI ? 1 : 0;
                      // Thin slices put their label just outside the pie so neighbours don't collide.
                      const thin = (b.value ?? 0) / total < 0.08;
                      const [lx, ly] = pt(mid, thin ? 55 : 31).split(' ');
                      return {
                        d: `M50 50L${pt(a0, 48)}A48 48 0 ${big} 1 ${pt(a1, 48)}Z`,
                        color: b.color || shade(c.color || '#aa3f3c', -0.35 + (0.6 * k) / Math.max(1, c.bars.length - 1)),
                        lx, ly, k, thin, label: b.label, value: b.value,
                      };
                    });
                    return (
                      <figure class:list={[...cls, 'chart']} aria-hidden={hide}>
                        {c.title && <figcaption class="chart-title">{c.title}</figcaption>}
                        <div class="pie-wrap">
                          <div class="pie">
                            <svg viewBox="0 0 100 100" role="img" aria-label={c.bars.map((b) => `${b.label} ${b.value}%`).join(', ')}>
                              {slices.map((sl) => <path d={sl.d} fill={sl.color} style={`--k:${sl.k}`}><title>{sl.label}: {sl.value}%</title></path>)}
                            </svg>
                            {slices.map((sl) => <span class:list={['pie-value', { outside: sl.thin }]} style={`left:${sl.lx}%;top:${sl.ly}%;--k:${sl.k}`}>{sl.value}%</span>)}
                          </div>
                          <ul class="pie-legend">
                            {slices.map((sl) => <li><span style={`background:${sl.color}`}></span>{sl.label}</li>)}
                          </ul>
                        </div>
                      </figure>
                    );
                  }
                  if (c.type === 'treemap') {
                    const cells = squarify(c.bars.map((b) => b.value ?? 0));
                    const n = c.bars.length;
                    return (
                      <figure class:list={[...cls, 'chart']} aria-hidden={hide}>
                        {c.title && <figcaption class="chart-title">{c.title}</figcaption>}
                        <div class="treemap">
                          {c.bars.map((b, k) => (
                            <div
                              class="tm-cell"
                              style={`left:${cells[k].x}%;top:${cells[k].y}%;width:${cells[k].w}%;height:${cells[k].h}%;background:${shade(c.color || '#3355af', n > 1 ? -0.45 + (0.9 * k) / (n - 1) : 0)};--k:${k}`}
                            >
                              <span class="tm-label">{(b.label ?? '').replace(/\//g, '/\u200b')}</span>
                              <span class="tm-value">{b.value}</span>
                            </div>
                          ))}
                        </div>
                      </figure>
                    );
                  }
                  const top = Math.max(...c.bars.map((b) => b.value ?? 0));
                  const step = top > 50 ? 20 : top > 20 ? 10 : 5;
                  const max = Math.ceil(top / step) * step || step;
                  const ticks = Array.from({ length: max / step + 1 }, (_, k) => k * step);
                  return (
                    <figure class:list={[...cls, 'chart']} aria-hidden={hide} style={`--bar:${c.color || '#aa3f3c'}`}>
                      {c.title && <figcaption class="chart-title">{c.title}</figcaption>}
                      <div class="chart-plot" style={`--rows:${c.bars.length}`}>
                        <div class="chart-grid" aria-hidden="true">
                          {ticks.map((tk) => <span style={`left:${(tk / max) * 100}%`}></span>)}
                        </div>
                        {c.bars.map((b, k) => (
                          <>
                            <span class="chart-label" style={`grid-row:${k + 1}`}>{b.label}</span>
                            <span class="chart-track" style={`grid-row:${k + 1}`}>
                              <span class="chart-bar" style={`--w:${((b.value ?? 0) / max) * 100}%;--k:${k}`}><span>{b.value}</span></span>
                            </span>
                          </>
                        ))}
                        <div class="chart-ticks" aria-hidden="true">
                          {ticks.map((tk) => <span style={`left:${(tk / max) * 100}%`}>{tk}</span>)}
                        </div>
                      </div>
                      {c.axis && <p class="chart-axis">{c.axis}</p>}
                    </figure>
                  );
                })}
              </div>
            </div>
          </section>
        );
      }

      if (s.discriminant === 'steps') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class="steps" data-steps>
              {v.steps.map((st, i) => (
                <div class:list={['step', { off: i !== 0 }]} inert={i !== 0} aria-hidden={i !== 0 ? 'true' : undefined} aria-label={`${i + 1} of ${v.steps.length}`}>
                  <div class="media step-media">{st.image && <img src={st.image} alt="" />}</div>
                  <div class="step-body">
                    <div class="step-main">
                      {st.label && <p class="eyebrow">{st.label}</p>}
                      {st.titleImage
                        ? <img class="step-logo" src={st.titleImage} alt={st.title || ''} />
                        : st.title && <h3 class="step-title" set:html={inline(st.title)} />}
                      {st.subtitle && <p class="step-subtitle">{st.subtitle}</p>}
                      <div class="prose step-text" set:html={richText(st.body)} />
                    </div>
                    <div class="step-foot">
                      {st.detailImage && <img class="step-detail" src={st.detailImage} alt="" />}
                      {st.detailCaption && <p class="step-caption">{st.detailCaption}</p>}
                      {v.steps.length > 1 && (
                        i === v.steps.length - 1 ? (
                          <button type="button" class="step-next back">
                            <svg viewBox="0 0 92 12" aria-hidden="true"><path d="M92 6H2M7 1L2 6l5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                            Back
                          </button>
                        ) : (
                          <button type="button" class="step-next">
                            Next step
                            <svg viewBox="0 0 92 12" aria-hidden="true"><path d="M0 6h90M85 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                          </button>
                        )
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (s.discriminant === 'decisions') {
        const v = s.value;
        return (
          <section id={s.anchor} class="section" data-reveal>
            {heading(v)}
            <div class="decisions">
              {v.rows.map((r) => (
                <div class="decision">
                  <div class="media">{r.imageA && <img src={r.imageA} alt="" />}</div>
                  <div class="media">{r.imageB && <img src={r.imageB} alt="" />}</div>
                  <div class="prose">
                    <p><strong>{r.title}</strong></p>
                    <div class="decision-text" set:html={richText(r.text)} />
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }
    })}
    </article>
    <div class="cell"></div>
    </div>

    <nav class="row more" aria-label="More projects">
      <div class="cell"></div>
      <div class="more-cells">
        <a href="/#work" class="cell more-link back"><span aria-hidden="true">&lt;</span> Return to homepage</a>
        {next.href ? (
          <a href={next.href} class="cell more-media" aria-label={`Next project: ${next.title}`} tabindex="-1">
            <span class="media">{next.cover && <img src={next.cover} alt="" loading="lazy" />}</span>
          </a>
        ) : (
          <div class="cell more-media"><span class="media">{next.cover && <img src={next.cover} alt="" loading="lazy" />}</span></div>
        )}
        {next.href
          ? <a href={next.href} class="cell more-link">See next project <span aria-hidden="true">&gt;</span></a>
          : <p class="cell more-link soon">Coming soon!</p>}
      </div>
      <div class="cell"></div>
    </nav>
  </div>

  <script>
    import { animate, inView } from 'motion';
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        inView(el, () => {
          animate(el, { opacity: [0, 1], y: [28, 0] }, { duration: 0.8, ease: [0.2, 0.7, 0.2, 1] });
        }, { amount: 0.15 });
      });
    } else {
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => (el.style.opacity = '1'));
    }

    // Impact numbers count up from zero the first time they scroll into view.
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const m = el.dataset.count!.match(/^(\D*)([\d,.]+)(.*)$/);
      if (!m || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const [, before, num, after] = m;
      const target = parseFloat(num.replace(/,/g, ''));
      const decimals = (num.split('.')[1] ?? '').length;
      const show = (n: number) => (el.textContent = before + n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + after);
      show(0);
      inView(el, () => {
        animate(0, target, { delay: 0.15, duration: 1.1, ease: [0.22, 1, 0.36, 1], onUpdate: show });
      }, { amount: 0.6 });
    });

    // Charts animate in the first time they're on screen and showing.
    document.querySelectorAll<HTMLElement>('.survey-visuals').forEach((wrap) => {
      let seen = false;
      const reveal = () => wrap.querySelectorAll('.chart:not(.off):not(.shown)').forEach((c) => c.classList.add('shown'));
      inView(wrap, () => { seen = true; reveal(); }, { amount: 0.3 });
      // When a tab switch shows another chart, let it animate in too.
      wrap.closest('.survey-split')?.querySelectorAll('[role=tab]').forEach((t) => t.addEventListener('click', () => seen && requestAnimationFrame(reveal)));
    });

    // Survey tabs: click or use the arrow keys to switch panels.
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
      const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const panels = [...box.querySelectorAll<HTMLElement>('[role=tabpanel]')];
      const visuals = [...(box.closest('.survey-split')?.querySelectorAll<HTMLElement>('.visual') ?? [])];
      const select = (i: number) => {
        tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
        panels.forEach((p, j) => {
          const off = i !== j;
          p.classList.toggle('off', off);
          p.inert = off;
          if (off) p.setAttribute('aria-hidden', 'true'); else p.removeAttribute('aria-hidden');
        });
        visuals.forEach((vis, j) => {
          vis.classList.toggle('off', i !== j);
          if (i !== j) vis.setAttribute('aria-hidden', 'true'); else vis.removeAttribute('aria-hidden');
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          const n = (i + d + tabs.length) % tabs.length;
          select(n); tabs[n].focus();
        });
      });
    });

    // Step-by-step boxes: Next step moves on, and the last one starts over.
    document.querySelectorAll<HTMLElement>('[data-steps]').forEach((box) => {
      const steps = [...box.querySelectorAll<HTMLElement>('.step')];
      steps.forEach((step, i) => {
        step.querySelector('.step-next')?.addEventListener('click', () => {
          const n = (i + 1) % steps.length;
          steps.forEach((st, j) => {
            const off = j !== n;
            st.classList.toggle('off', off);
            st.inert = off;
            if (off) st.setAttribute('aria-hidden', 'true'); else st.removeAttribute('aria-hidden');
          });
          steps[n].querySelector<HTMLElement>('.step-next')?.focus({ preventScroll: true });
        });
      });
    });

    // Drop-downs: one open at a time; the image follows the open item.
    document.querySelectorAll<HTMLElement>('.accordion').forEach((acc) => {
      const items = [...acc.querySelectorAll<HTMLElement>('.acc-item')];
      const slides = [...acc.querySelectorAll<HTMLElement>('.acc-slide')];
      // Show the open item's video or image (with its floating layers), else the section's default image.
      const media = acc.querySelector<HTMLElement>('.acc-media')!;
      const show = (key: string) => {
        // With nothing to show (all closed, no default image), the box disappears.
        media.classList.toggle('empty', !slides.some((slide) => slide.dataset.slide === key));
        slides.forEach((slide) => {
          const on = slide.dataset.slide === key;
          slide.classList.toggle('on', on);
          const video = slide.querySelector('video');
          if (!video) return;
          if (on) { video.currentTime = 0; video.play().catch(() => {}); } else video.pause();
        });
      };
      items.forEach((item) => {
        item.querySelector('.acc-head')!.addEventListener('click', () => {
          const opening = !item.classList.contains('open');
          items.forEach((other) => {
            const on = other === item && opening;
            other.classList.toggle('open', on);
            other.querySelector('.acc-head')!.setAttribute('aria-expanded', String(on));
          });
          show(opening ? item.dataset.slide! : 'default');
        });
      });
    });
  </script>
</Layout>

