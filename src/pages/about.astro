---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/Layout.astro';

const page = await createReader(process.cwd(), keystaticConfig).singletons.about.readOrThrow();
const paragraphs = (page.body ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const hobbies = page.hobbies ?? [];
---
<Layout title="About Me · Chloe Jung" current="about">
  <!-- A thin row of cells above and below; the text and photo sit between them, as in Aboutme.svg. -->
  <div class="row about spacer">
    <div class="cell"></div><div class="cell wide-only"></div><div class="cell"></div><div class="cell wide-only"></div><div class="cell wide-only"></div><div class="cell wide-only"></div><div class="cell"></div>
  </div>
  <section class="row about main-row">
    <div class="cell"></div>
    <div class="cell wide-only"></div>
    <div class="cell text">
      <h1>{page.heading}</h1>
      <div class="body">{paragraphs.map((p) => <p>{p}</p>)}</div>
    </div>
    <div class="cell wide-only"></div>
    <div class="cell photo">
      {page.photo && <img src={page.photo} alt={page.photoAlt} width="1190" height="1400" />}
    </div>
    <div class="cell wide-only"></div>
    <div class="cell"></div>
  </section>
  <div class="row about spacer">
    <div class="cell"></div><div class="cell wide-only"></div><div class="cell"></div><div class="cell wide-only"></div><div class="cell wide-only"></div><div class="cell wide-only"></div><div class="cell"></div>
  </div>

  {hobbies.length > 0 && (
    <>
      <div class="row gap-row"><div class="cell"></div><h2 class="cell hobbies-heading">{page.hobbiesHeading}</h2><div class="cell"></div></div>
      <section class="row" aria-label={page.hobbiesHeading || 'Outside of design'}>
        <div class="cell"></div>
        <div class="cell hobbies">
          {hobbies.map((h, i) => (
            <figure class:list={['hobby', `hobby-${i + 1}`]}>
              <div class="shots">
                {h.images.map((im) => im.image && <img src={im.image} alt={im.alt} loading="lazy" decoding="async" />)}
              </div>
              <figcaption>
                <h2>{h.title}</h2>
                <p>{h.text}</p>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="cell"></div>
      </section>
    </>
  )}
</Layout>

<style>
  /* Phones and tablets: text, then the photo, in the main column. */
  .about { grid-template-columns: var(--gutter) minmax(0, 1fr) var(--gutter); flex-shrink: 0; }
  .wide-only { display: none; }
  .main-row { grid-template-rows: auto auto; }
  .main-row > .cell:first-child, .main-row > .cell:last-child { grid-row: span 2; }
  .main-row .photo { grid-column: 2; }
  .spacer { min-height: max(28px, calc(60 * var(--u))); }

  .text { padding: max(32px, calc(60 * var(--u))) var(--pad); }
  h1 { font-family: var(--font-serif); font-size: max(30px, calc(50 * var(--u))); line-height: 1.24; letter-spacing: -0.01em; text-wrap: pretty; max-width: 15em; }
  .body { margin-top: max(24px, calc(48 * var(--u))); display: grid; gap: 1.4em; max-width: 44em; font-size: max(15px, calc(18 * var(--u))); line-height: 1.39; }

  .photo { position: relative; overflow: hidden; aspect-ratio: 509 / 599; }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Outside of design: photos with a caption each. */
  .gap-row { min-height: max(48px, calc(120 * var(--u))); flex-shrink: 0; }
  .hobbies-heading { display: grid; place-items: center; text-align: center; padding: 12px var(--pad); font-family: var(--font-serif); font-size: var(--text-display); line-height: 1.1; letter-spacing: -0.01em; }
  .hobbies { display: grid; gap: max(36px, calc(48 * var(--u))); padding: max(32px, calc(60 * var(--u))) var(--pad) calc(max(32px, calc(60 * var(--u))) + 30px); }
  .hobby { display: flex; flex-direction: column; gap: max(16px, calc(28 * var(--u))); }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 12px; }
  .shots img { width: 100%; height: 100%; object-fit: cover; border-radius: max(10px, calc(15 * var(--u))); }
  .hobby-1 .shots img { aspect-ratio: 393 / 450; }
  .hobby-2 .shots img { aspect-ratio: 4 / 3; }
  .hobby-3 .shots img { aspect-ratio: 420 / 450; }
  .hobby-3 { flex-direction: column-reverse; }
  figcaption h2 { font-weight: 700; font-size: max(16px, calc(20 * var(--u))); }
  figcaption p { margin-top: 0.3em; font-size: max(15px, calc(18 * var(--u))); line-height: 1.39; }

  /* Wide: laid out as in aboutme_02.svg, measured from the box's top-left corner at 1920px. */
  @container (min-width: 900px) {
    .hobbies {
      position: relative; display: block; padding: 0;
      height: calc(750 * var(--u)); min-height: 0;
    }
    .hobby { position: absolute; gap: 0; }
    .hobby-1 { left: calc(61 * var(--u)); top: calc(60 * var(--u)); width: calc(410 * var(--u)); }
    .hobby-1 .shots { width: calc(393 * var(--u)); }
    .hobby-1 figcaption { margin-top: calc(28 * var(--u)); }

    /* Two photos overlapping, the smaller one in front, with the caption beside it. */
    .hobby-2 { left: calc(542 * var(--u)); top: calc(120 * var(--u)); width: calc(720 * var(--u)); height: calc(452 * var(--u)); }
    .hobby-2 .shots { display: block; }
    .hobby-2 .shots img { position: absolute; height: auto; }
    .hobby-2 .shots img:nth-child(1) { left: calc(210 * var(--u)); top: 0; width: calc(420 * var(--u)); aspect-ratio: 420 / 274; }
    .hobby-2 .shots img:nth-child(2) { left: 0; top: calc(227 * var(--u)); width: calc(300 * var(--u)); aspect-ratio: 300 / 225; }
    .hobby-2 figcaption { position: absolute; left: calc(330 * var(--u)); top: calc(300 * var(--u)); width: calc(300 * var(--u)); }

    .hobby-3 { left: calc(1260 * var(--u)); top: calc(60 * var(--u)); width: calc(420 * var(--u)); }
    .hobby-3 figcaption { margin-bottom: calc(18 * var(--u)); }
  }

  /* Wide: 120 | text 930 | 60 | photo 510 | 120 inside the gutters, the photo as tall as the text box. */
  @container (min-width: 900px) {
    .about { grid-template-columns: var(--gutter) calc(120 * var(--u)) minmax(0, 1fr) calc(60 * var(--u)) calc(510 * var(--u)) calc(120 * var(--u)) var(--gutter); }
    .wide-only { display: block; }
    .main-row { grid-template-rows: auto; }
    .main-row > .cell:first-child, .main-row > .cell:last-child { grid-row: auto; }
    .main-row .photo { grid-column: auto; aspect-ratio: auto; }
    .main-row { min-height: max(480px, calc(600 * var(--u))); }
    .text { display: flex; flex-direction: column; justify-content: center; padding: calc(60 * var(--u)); }
  }
</style>
