---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/Layout.astro';

const page = await createReader(process.cwd(), keystaticConfig).singletons.about.readOrThrow();
---
<Layout title={`${page.heading} · Chloe Jung`} current="about">
  <section class="row">
    <div class="cell"></div>
    <div class="cell main">
      <h1 class="text-display">{page.heading}</h1>
      <p class="intro">{page.intro}</p>
    </div>
    <div class="cell"></div>
  </section>
</Layout>

<style>
  .main { min-height: max(360px, calc(600 * var(--u))); padding: max(40px, calc(90 * var(--u))) var(--pad); }
  .intro { margin-top: 24px; max-width: 60ch; white-space: pre-line; font-size: max(15px, calc(18 * var(--u))); color: var(--color-muted); }
</style>
