---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavLink, Page } from '../navLinks';

interface Props { title: string; current: Page; sections?: NavLink[]; }
const { title, current, sections } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      // Every page opens at the top unless the link points at a section.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      // scrollIntoView also moves a surrounding frame (like the preview window) to the top.
      if (!location.hash) {
        const toTop = () => {
          scrollTo(0, 0);
          document.body?.firstElementChild?.scrollIntoView({ block: 'start' });
        };
        addEventListener('DOMContentLoaded', toTop);
        addEventListener('load', () => { toTop(); setTimeout(toTop, 150); });
      }
    </script>
  </head>
  <body id="top">
    <!-- Designed on a 1920px canvas; everything scales with the window (see --u). -->
    <div class="site">
      <Header current={current} sections={sections} />
      <main>
        <slot />
      </main>
    </div>
    <Footer current={current} />
  </body>
</html>

<style>
  /* On short pages the footer still sits at the bottom of the window. */
  body { min-height: 100svh; display: flex; flex-direction: column; }
  .site { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 1920px; margin-inline: auto; container-type: inline-size; }
  /* Section links land just below the sticky header. */
  .site :global([id]) { scroll-margin-top: var(--header-h, 160px); }
</style>
